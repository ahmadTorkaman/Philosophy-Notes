# ============================================
# TELEGRAM BOT CONFIGURATION
# ============================================

# Get from @BotFather on Telegram
# 1. Search for @BotFather
# 2. Send /newbot
# 3. Follow prompts to create your bot
# 4. Copy the token here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ============================================
# AI PROVIDER CONFIGURATION
# ============================================

# OPTION 1: Google Gemini (Default)
# Get from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# OPTION 2: Anthropic Claude
# Get from https://console.anthropic.com/
# Uncomment to use Claude instead of Gemini
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# CLAUDE_MODEL=claude-sonnet-4-20250514

# ============================================
# APPLICATION SETTINGS
# ============================================

# Timezone for daily summaries (default: Asia/Tehran)
DEFAULT_TIMEZONE=Asia/Tehran

# Time for daily summaries (24-hour format)
DEFAULT_SUMMARY_TIME=23:00

# ============================================
# SYNC SERVER CONFIGURATION
# ============================================

# Host for sync server (0.0.0.0 allows external connections)
SYNC_SERVER_HOST=0.0.0.0

# Port for sync server (Render sets this automatically)
PORT=5000
