# ============================================
# TELEGRAM BOT CONFIGURATION
# ============================================

# Get from @BotFather on Telegram
# 1. Search for @BotFather
# 2. Send /newbot
# 3. Follow prompts to create your bot
# 4. Copy the token here
TELEGRAM_BOT_TOKEN=8389785688:AAEXCAurAYqu7FM7aWRVkYS2koJ9BmfJDr4

# ============================================
# GEMINI API CONFIGURATION
# ============================================

# Get from Google AI Studio: https://aistudio.google.com/app/apikey
# 1. Go to https://aistudio.google.com/app/apikey
# 2. Click "Create API Key"
# 3. Copy the key here
GEMINI_API_KEY=AIzaSyDaN8nndbUU8lfReReIiH786zf4DLrFcgc

# Gemini model to use (recommended: gemini-1.5-pro)
# Options: gemini-1.5-pro, gemini-1.5-flash
GEMINI_MODEL=gemini-1.5-pro

# ============================================
# APPLICATION SETTINGS
# ============================================

# Timezone for daily summaries (default: Asia/Tehran)
DEFAULT_TIMEZONE=Asia/Tehran

# Time for daily summaries (24-hour format)
DEFAULT_SUMMARY_TIME=23:00

# ============================================
# SYNC SERVER CONFIGURATION
# ============================================

# Host for sync server (0.0.0.0 allows external connections)
SYNC_SERVER_HOST=0.0.0.0

# Port for sync server
SYNC_SERVER_PORT=5000

# ============================================
# OPTIONAL: ANTHROPIC API (for Claude)
# ============================================

# If you want to use Claude instead of Gemini, uncomment and add:
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# CLAUDE_MODEL=claude-sonnet-4-20250514
