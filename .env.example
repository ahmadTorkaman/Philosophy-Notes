# Philosophy Notes Bot - Environment Variables

# Telegram Bot Token (Required)
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Anthropic API Key (Required for AI summaries)
# Get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Port for local development
# (Render automatically sets this)
PORT=5000

# Optional: Timezone
DEFAULT_TIMEZONE=Asia/Tehran

# Optional: Daily summary time
DEFAULT_SUMMARY_TIME=23:00
